# ==============================================================================
# SHREY SHAH PORTFOLIO - ENVIRONMENT CONFIGURATION
# ==============================================================================
# All secrets must remain server-side only. Do not expose private keys to client.
# ==============================================================================

# Site URLs
NEXT_PUBLIC_SITE_URL="https://shreyks.com"
NEXT_PUBLIC_DEMO_URL=""

# Email Notifications (Zoho Mail SMTP via Nodemailer)
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=

# Runbook Copilot Live Demo Proxy (FastAPI on Modal / Render)
# If left empty, /api/chat will return 503 "Demo coming soon"
RUNBOOK_COPILOT_API_URL=""
RUNBOOK_COPILOT_TOKEN=""
